# Set these as hosting environment variables. ASP.NET does not read this file automatically.
ConnectionStrings__DefaultConnection=Host=your-neon-host;Database=your_database;Username=your_user;Password=replace_me;SSL Mode=Require
Jwt__Key=replace_with_a_long_random_signing_key
Jwt__Issuer=LegalServiceAPI
Jwt__Audience=LegalServiceUsers
Jwt__ExpiryMinutes=60
AiService__BaseUrl=https://your-main-ai-service.example
Ai__BaseUrl=https://your-recommendation-service.example/
Ai__InternalKey=replace_with_random_recommendation_key
AI_SERVICE_API_KEY=replace_with_random_main_ai_key
Cors__Origins__0=https://your-react-site.example
Swagger__Enabled=true
SeedAccounts__AdminEmail=evaluator-admin@example.com
SeedAccounts__AdminPassword=replace_me
SeedAccounts__ClerkEmail=evaluator-clerk@example.com
SeedAccounts__ClerkPassword=replace_me
EmailSettings__SmtpHost=your-smtp-host
EmailSettings__SmtpPort=587
EmailSettings__EnableSsl=true
EmailSettings__SenderEmail=sender@example.com
EmailSettings__SenderName=Legal Service
EmailSettings__AppPassword=replace_me
EmailSettings__FallbackRecipientEmail=evaluator@example.com
