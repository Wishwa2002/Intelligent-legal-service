# ============================================================
# AI Service — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER print or log any of these values.
# ============================================================

# ---- Gemini API ----
GEMINI_API_KEY=your_gemini_api_key_here
# Model name is configurable — never hardcoded anywhere in the codebase.
GEMINI_MODEL=gemini-2.5-flash

# ---- ASP.NET Core Backend ----
BACKEND_API_URL=http://localhost:5000
# Shared secret for requests FROM the backend TO this AI service.
AI_SERVICE_API_KEY=

# ---- Document Processing ----
OCR_ENABLED=true
MAX_DOCUMENT_SIZE_MB=10

# ---- Confidence Thresholds (enforced in Python, not by Gemini) ----
# >= HIGH  → auto-accept, continue workflow
HIGH_CONFIDENCE_THRESHOLD=0.90
# >= MEDIUM and < HIGH → accept but flag for human review
MEDIUM_CONFIDENCE_THRESHOLD=0.70
# < MEDIUM → reject, ask client to re-upload with specific reason

# ---- Safety Limits ----
# Max times a client can re-upload the same document before forced human review
MAX_REUPLOAD_ATTEMPTS_PER_DOCUMENT=3
# Max total agent node executions per workflow run before forced pause
MAX_TOTAL_AGENT_ITERATIONS=10
