      SELECT l."LawyerId", CASE
          WHEN btrim(l."Name", E' \t\n\r') = '' THEN l."Qualification"
          ELSE l."Name"
      END, l."Email", l."PhoneNumber", l."Qualification", l."Experience", l."LicenseNumber", l."ProfileDescription", l."Status", t."specializationId", t.name, t.description, t."LawyerId", t."SpecializationId0"
      FROM "Lawyers" AS l
      LEFT JOIN (
          SELECT l0."SpecializationId" AS "specializationId", s."Name" AS name, s."Description" AS description, l0."LawyerId", s."SpecializationId" AS "SpecializationId0"
          FROM "LawyerSpecializations" AS l0
          INNER JOIN "Specializations" AS s ON l0."SpecializationId" = s."SpecializationId"
      ) AS t ON l."LawyerId" = t."LawyerId"
      ORDER BY l."Name", l."LawyerId", t."LawyerId", t."specializationId"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[], CommandType='Text', CommandTimeout='30']
      SELECT s."SpecializationId" AS "specializationId", s."Name" AS name, s."Description" AS description, (
          SELECT count(*)::int
          FROM "LawyerSpecializations" AS l
          WHERE s."SpecializationId" = l."SpecializationId") AS "lawyerCount", (
          SELECT count(*)::int
          FROM "LawyerSpecializations" AS l0
          INNER JOIN "Lawyers" AS l1 ON l0."LawyerId" = l1."LawyerId"
          WHERE s."SpecializationId" = l0."SpecializationId" AND l1."Status" = 'Active' AND (
              SELECT count(*)::int
              FROM "LawyerSpecializations" AS l2
              WHERE l1."LawyerId" = l2."LawyerId") = 1) AS "activeLawyerCount", (
          SELECT count(*)::int
          FROM "LegalServices" AS l3
          WHERE lower(l3."Category") = lower(s."Name")) AS "legalServiceCount"
      FROM "Specializations" AS s
      ORDER BY s."SpecializationId"
