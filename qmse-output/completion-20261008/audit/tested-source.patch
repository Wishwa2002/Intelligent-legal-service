+    }
+    [Fact] public async Task Qmse_DEF13_SeedsTwelveServicesIdempotently()
+    {
+        using var db=Database(); await DbInitializer.SeedDocumentationServicesAsync(db); Assert.Equal(12,await db.DocumentationServices.CountAsync());
